__pycache__/
logs/
# Working copies of the generated traces. The committed, gzipped datasets live in cots/;
# these are the raw per-shard files cot_gen.py appends to during a run.
outputs/*.jsonl
outputs/*_summary.json
outputs/*_q.shard*.json
outputs/t16_q.shard*.json

# The judged-premise data is DERIVED but not cheap: ~15 GPU-hours. An earlier run was lost
# because it sat untracked in this gitignored directory. Committed gzipped, like cots/.
!outputs/vp_premises.jsonl.gz
!outputs/vp_verdicts.jsonl.gz
